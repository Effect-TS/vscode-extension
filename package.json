{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel --filter \"./packages/**/*\" run codegen",
    "build": "tsc -b tsconfig.build.json && pnpm --recursive --parallel --filter \"./packages/**/*\" run build",
    "dev": "pnpm --recursive --parallel --filter \"./packages/**/*\" run dev",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "check": "tsc -b tsconfig.json",
    "check-recursive": "pnpm --recursive --filter \"./packages/**/*\" exec tsc -b tsconfig.json",
    "lint": "eslint \"**/{src,test,examples,dtslint}/**/*.{ts,tsx,mjs}\"",
    "lint-fix": "pnpm lint --fix",
    "changeset-version": "changeset version",
    "changeset-publish": "pnpm codemod && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@edge-runtime/vm": "^5.0.0",
    "@effect/build-utils": "^0.8.9",
    "@effect/docgen": "https://pkg.pr.new/Effect-TS/docgen/@effect/docgen@49e99a2",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.57.0",
    "@effect/platform": "^0.93.4",
    "@effect/platform-node": "^0.101.2",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^24.10.1",
    "@vitest/browser": "4.0.14",
    "@vitest/coverage-v8": "4.0.14",
    "@vitest/expect": "4.0.14",
    "@vitest/web-worker": "4.0.14",
    "ast-types": "^0.14.2",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "effect": "^3.19.7",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "glob": "^13.0.0",
    "happy-dom": "^20.0.10",
    "i18next": "^25.6.3",
    "jscodeshift": "^17.3.0",
    "madge": "^8.0.0",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3",
    "rollup-plugin-bundle-stats": "^4.21.7",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.1",
    "tstyche": "^5.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.0.14",
    "vitest-websocket-mock": "^0.5.0",
    "zod": "^4.1.13"
  }
}
