{
  "name": "effect-vscode",
  "type": "module",
  "displayName": "Effect Dev Tools",
  "description": "Tools to assist development with the Effect Typescript framework",
  "icon": "resources/icons/effect-dark.png",
  "version": "0.8.0",
  "private": true,
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "vscode": "^1.84.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/effect-ts/vscode-extension.git"
  },
  "license": "MIT",
  "categories": [
    "Debuggers",
    "Visualization"
  ],
  "activationEvents": [
    "onDebug"
  ],
  "main": "./dist/extension.cjs",
  "publisher": "effectful-tech",
  "contributes": {
    "configuration": {
      "title": "Effect Dev Tools",
      "properties": {
        "effect.devServer.port": {
          "type": "integer",
          "description": "The port to run the Effect dev server on",
          "title": "Dev Server Port",
          "default": 34437
        },
        "effect.instrumentation.injectDebugConfigurations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of debug configuration types to inject the instrumentation into when injectNodeOptions is enabled",
          "title": "Inject Debug Configurations",
          "default": [
            "node",
            "node-terminal",
            "pwa-node"
          ]
        },
        "effect.instrumentation.injectNodeOptions": {
          "type": "boolean",
          "description": "If enabled, the effect instrumentation code will be injected into node debug configurations by appending a NODE_OPTIONS environment variable",
          "title": "Inject Node Options",
          "default": false
        },
        "effect.metrics.pollInterval": {
          "type": "integer",
          "description": "The time in milliseconds between polling for metrics",
          "title": "Metrics Poll Interval",
          "default": 500
        },
        "effect.spanStack.ignoreList": {
          "type": "array",
          "items": {
            "type": "string",
            "default": ""
          },
          "description": "A list of span patterns to ignore when showing the span stack",
          "title": "Span Stack Ignore List",
          "default": []
        },
        "effect.tracer.pollInterval": {
          "type": "integer",
          "description": "The time in milliseconds between polling for span data while using the debug protocol transport",
          "title": "Tracer Poll Interval",
          "default": 250
        }
      }
    },
    "commands": [
      {
        "command": "effect.debugFibersRefresh",
        "title": "Effect Dev Tools: Refresh Debug Fibers",
        "icon": "$(refresh)",
        "enablement": "true"
      },
      {
        "command": "effect.interruptDebugFiber",
        "title": "Effect Dev Tools: Interrupt Fiber",
        "icon": "$(debug-stop)",
        "enablement": "inDebugMode"
      },
      {
        "command": "effect.revealFiberCurrentSpan",
        "title": "Effect Dev Tools: Reveal Fiber Current Span Location",
        "icon": "$(go-to-file)",
        "enablement": "true"
      },
      {
        "command": "effect.debugContextRefresh",
        "title": "Effect Dev Tools: Refresh Debug Context",
        "icon": "$(refresh)",
        "enablement": "true"
      },
      {
        "command": "effect.debugSpanStackRefresh",
        "title": "Effect Dev Tools: Refresh Debug Span Stack",
        "icon": "$(refresh)",
        "enablement": "true"
      },
      {
        "command": "effect.revealSpanLocation",
        "title": "Effect Dev Tools: Reveal Span Location",
        "icon": "$(go-to-file)",
        "enablement": "true"
      },
      {
        "command": "effect.disableSpanStackIgnoreList",
        "title": "Effect Dev Tools: Disable Span Stack Ignore List",
        "icon": "$(eye)",
        "enablement": "effect:spanStackIgnoreListEnabled === true"
      },
      {
        "command": "effect.enableSpanStackIgnoreList",
        "title": "Effect Dev Tools: Enable Span Stack Ignore List",
        "icon": "$(eye-closed)",
        "enablement": "effect:spanStackIgnoreListEnabled === false"
      },
      {
        "command": "effect.togglePauseOnDefects",
        "title": "Effect Dev Tools: Toggle Pause on Defects",
        "enablement": "inDebugMode"
      },
      {
        "command": "effect.selectClient",
        "title": "Effect Dev Tools: Select Client",
        "enablement": "effect:hasClients"
      },
      {
        "command": "effect.attachDebugSessionClient",
        "title": "Effect Dev Tools: Attach Debug Session Client",
        "icon": "$(debug)",
        "enablement": "effect:hasDebugTargets"
      },
      {
        "command": "effect.resetMetrics",
        "title": "Effect Dev Tools: Reset Metrics",
        "icon": "$(refresh)",
        "enablement": "true"
      },
      {
        "command": "effect.resetTracer",
        "title": "Effect Dev Tools: Reset Tracer",
        "icon": "$(refresh)",
        "enablement": "true"
      },
      {
        "command": "effect.resetTracerExtended",
        "title": "Effect Dev Tools: Reset Tracer Extended",
        "icon": "$(refresh)",
        "enablement": "true"
      },
      {
        "command": "effect.startServer",
        "title": "Effect Dev Tools: Start Server",
        "icon": "$(play)",
        "enablement": "effect:running === false"
      },
      {
        "command": "effect.stopServer",
        "title": "Effect Dev Tools: Stop Server",
        "icon": "$(debug-stop)",
        "enablement": "effect:running === true"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "effect",
          "title": "Effect Dev Tools",
          "icon": "resources/icons/effect-light.svg"
        }
      ],
      "panel": [
        {
          "id": "effect-tracer-panel",
          "title": "Effect Tracer",
          "icon": "resources/icons/effect-light.svg"
        }
      ]
    },
    "views": {
      "debug": [
        {
          "id": "effect-debug-fibers",
          "name": "Effect Fibers",
          "when": "inDebugMode"
        },
        {
          "id": "effect-context",
          "name": "Effect Context",
          "when": "inDebugMode"
        },
        {
          "id": "effect-debug-span-stack",
          "name": "Effect Span Stack",
          "when": "inDebugMode"
        },
        {
          "id": "effect-debug-breakpoints",
          "name": "Effect Breakpoints",
          "when": "inDebugMode"
        }
      ],
      "effect": [
        {
          "id": "effect-clients",
          "name": "Clients",
          "when": "true"
        },
        {
          "id": "effect-metrics",
          "name": "Metrics",
          "when": "true"
        },
        {
          "id": "effect-tracer",
          "name": "Tracer",
          "when": "true"
        }
      ],
      "effect-tracer-panel": [
        {
          "type": "webview",
          "id": "effect-tracer-extended",
          "name": "Tracer",
          "when": "true"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "effect-clients",
        "contents": "The Effect Dev Tools server is currently stopped.\n[Start the server](command:effect.startServer)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "effect.startServer",
          "when": "view === effect-clients && effect:running === false",
          "group": "navigation"
        },
        {
          "command": "effect.stopServer",
          "when": "view === effect-clients && effect:running === true",
          "group": "navigation"
        },
        {
          "command": "effect.attachDebugSessionClient",
          "when": "view === effect-clients && effect:hasDebugTargets",
          "group": "navigation"
        },
        {
          "command": "effect.resetMetrics",
          "when": "view === effect-metrics && true",
          "group": "navigation"
        },
        {
          "command": "effect.resetTracer",
          "when": "view === effect-tracer && true",
          "group": "navigation"
        },
        {
          "command": "effect.resetTracerExtended",
          "when": "view === effect-tracer-extended && true",
          "group": "navigation"
        },
        {
          "command": "effect.debugContextRefresh",
          "when": "view === effect-context && true",
          "group": "navigation"
        },
        {
          "command": "effect.debugFibersRefresh",
          "when": "view === effect-debug-fibers && true",
          "group": "navigation"
        },
        {
          "command": "effect.debugSpanStackRefresh",
          "when": "view === effect-debug-span-stack && true",
          "group": "navigation"
        },
        {
          "command": "effect.enableSpanStackIgnoreList",
          "when": "view === effect-debug-span-stack && effect:spanStackIgnoreListEnabled === false",
          "group": "navigation"
        },
        {
          "command": "effect.disableSpanStackIgnoreList",
          "when": "view === effect-debug-span-stack && effect:spanStackIgnoreListEnabled === true",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "effect.interruptDebugFiber",
          "when": "view === effect-debug-fibers && inDebugMode && (viewItem === FiberId)",
          "group": "inline"
        },
        {
          "command": "effect.revealFiberCurrentSpan",
          "when": "view === effect-debug-fibers && true && (viewItem === FiberId)",
          "group": "inline"
        },
        {
          "command": "effect.revealSpanLocation",
          "when": "view === effect-debug-span-stack && true && (viewItem === SpanNode)",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm build",
    "build": "tsup",
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@effect/experimental": "catalog:",
    "@effect/devtools-shared": "workspace:^",
    "@swc/core": "^1.15.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "~24.10.1",
    "@types/vscode": "^1.84.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.0",
    "glob": "^11.0.3",
    "minimatch": "^10.1.1",
    "mocha": "^11.7.5",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "ws": "^8.18.3"
  },
  "sideEffects": false,
  "pnpm": {
    "updateConfig": {
      "ignoreDependencies": [
        "@types/vscode"
      ]
    }
  }
}